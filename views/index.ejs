<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PHeripheral INC | Gaming Rigs & PC Hardware</title>
  
  <!-- Google Fonts: Rajdhani & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  
  <!-- Minimal Bootstrap 5 CSS (Grid & Utilities) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-utilities.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">

</head>
<body>

  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="#" class="brand-logo"> PHeripheral <span>INC</span></a>
      
      <div class="d-none d-md-flex align-items-center gap-4">
        <a href="#" class="nav-link-custom active"><i class="bi bi-house-door me-1"></i> Home</a>
        <a href="#categories" class="nav-link-custom"><i class="bi bi-grid me-1"></i> Categories</a>
        <a href="#products" class="nav-link-custom"><i class="bi bi-cpu me-1"></i> Gear</a>
        <a href="pcbuild" class="nav-link-custom"><i class="bi bi-wrench-adjustable me-1"></i> PC Builder</a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <a href="/login" class="nav-link-custom d-none d-sm-inline-flex align-items-center">
          <i class="bi bi-person me-1"></i> LOGIN
        </a>
        <button class="btn btn-cyber py-2 px-3 fs-6">
          <i class="bi bi-cart3 fs-5"></i>
          <span class="d-none d-sm-inline">CART</span>
        </button>
      </div>
    </div>
  </nav>

  <header class="hero-banner">
    <div class="container text-center">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <span class="badge bg-danger mb-3 px-3 py-2 text-uppercase tracking-wide fs-7">Official Tech Reseller</span>
          <h1 class="hero-title mb-3"><%= hero.title %></h1>
          <p class="text-secondary fs-5 mb-4"><%= hero.subtitle %></p>
          <a href="<%= hero.ctaLink %>" class="btn-cyber">
            <%= hero.ctaText %> <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </header>

  <section id="categories" class="py-5">
    <div class="container my-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="section-header m-0">BROWSE CATEGORIES</h2>
          <p class="text-secondary small mt-2 m-0">Find components by hardware category</p>
        </div>
      </div>

      <!-- Minimal Bootstrap Grid Row -->
      <div class="row g-3">
        <% categories.forEach(category => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <div class="category-card">
              <% if(category.badge) { %>
                <span class="category-badge"><%= category.badge %></span>
              <% } %>
              
              <!-- Bootstrap Icon container -->
              <div class="category-icon-box">
                <i class="bi <%= category.icon %>"></i>
              </div>
              
              <h3 class="category-title"><%= category.name %></h3>
              <div class="category-count"><i class="bi bi-layers me-1"></i><%= category.itemCount %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="products" class="py-5" style="background: var(--bg-surface);">
    <div class="container my-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="section-header m-0">FEATURED HARDWARE</h2>
          <p class="text-secondary small mt-2 m-0">Authentic gaming hardware with store warranty</p>
        </div>
      </div>

      <!-- Minimal Bootstrap Grid Row for Products -->
      <div class="row g-4">
        <% products.forEach(product => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="product-card">
              <% if(product.badge) { %>
                <span class="product-badge-pill"><%= product.badge %></span>
              <% } %>
              
              <div class="product-img-box">
                <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
              </div>

              <div class="product-body">
                <span class="text-uppercase small text-secondary mb-1 fw-bold"><%= product.category %></span>
                <h3 class="fs-6 fw-semibold mb-3 text-white"><%= product.name %></h3>
                
                <div class="mt-auto d-flex align-items-center justify-content-between pt-2">
                  <div>
                    <span class="fs-5 fw-bold text-info font-monospace"><%= product.price %></span>
                    <% if(product.oldPrice) { %>
                      <span class="text-muted text-decoration-line-through small ms-1"><%= product.oldPrice %></span>
                    <% } %>
                  </div>
                  <button class="btn-add-cart">
                    <i class="bi bi-cart-plus me-1"></i> Add
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <footer class="py-4 text-center">
    <div class="container">
      <p class="mb-1">&copy; 2026  PHripheral Concept. All rights reserved.</p>
      <small class="text-secondary">Powered by Node.js, Express, EJS & Bootstrap Icons CDN.</small>
    </div>
  </footer>

</body>
</html>