<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PHeripheral INC | Gaming Rigs & PC Hardware</title>
  
  <!-- Google Fonts: Rajdhani & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  
  <!-- Minimal Bootstrap 5 CSS (Grid & Utilities) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-utilities.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <!-- Custom Dark Gaming Styling -->
  <style>
    :root {
      --bg-dark: #080b11;
      --bg-surface: #101622;
      --bg-card: #151d2d;
      --bg-card-hover: #1c273c;
      --accent-cyan: #00f0ff;
      --accent-red: #ff2a4b;
      --accent-glow: rgba(0, 240, 255, 0.15);
      --text-main: #f0f4f8;
      --text-muted: #8c9ba5;
      --border-color: #212c40;
      --font-heading: 'Rajdhani', sans-serif;
      --font-body: 'Inter', sans-serif;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-body);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .itech-navbar {
      background: rgba(8, 11, 17, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .brand-logo {
      font-family: var(--font-heading);
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #fff;
      text-decoration: none;
    }

    .brand-logo span {
      color: var(--accent-red);
    }

    .nav-link-custom {
      color: var(--text-muted);
      font-weight: 500;
      text-decoration: none;
      transition: color 0.2s ease;
      font-size: 0.95rem;
    }

    .nav-link-custom:hover {
      color: var(--accent-cyan);
    }

    .hero-banner {
      background: radial-gradient(circle at top right, rgba(0, 240, 255, 0.1), transparent 50%),
                  radial-gradient(circle at bottom left, rgba(255, 42, 75, 0.1), transparent 50%),
                  linear-gradient(rgba(8, 11, 17, 0.85), rgba(8, 11, 17, 0.95)),
                  url('https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1920&q=80') center/cover;
      padding: 90px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .hero-title {
      font-family: var(--font-heading);
      font-size: 3.5rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      background: linear-gradient(90deg, #ffffff, var(--accent-cyan));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
    }

    .btn-cyber {
      background-color: var(--accent-cyan);
      color: var(--bg-dark);
      font-weight: 700;
      padding: 12px 28px;
      border-radius: 4px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      letter-spacing: 1px;
      text-transform: uppercase;
      box-shadow: 0 0 20px var(--accent-glow);
      transition: all 0.3s ease;
      border: none;
    }

    .btn-cyber:hover {
      background-color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
    }

    .section-header {
      font-family: var(--font-heading);
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 1px;
      position: relative;
      display: inline-block;
      text-transform: uppercase;
    }

    .section-header::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      width: 40px;
      height: 3px;
      background-color: var(--accent-red);
    }

    .category-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 24px 16px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .category-card:hover {
      background-color: var(--bg-card-hover);
      border-color: var(--accent-cyan);
      transform: translateY(-6px);
      box-shadow: 0 10px 25px rgba(0, 240, 255, 0.1);
    }

    .category-icon-box {
      width: 58px;
      height: 58px;
      border-radius: 8px;
      background: rgba(0, 240, 255, 0.08);
      border: 1px solid rgba(0, 240, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      color: var(--accent-cyan);
      transition: all 0.3s ease;
    }

    .category-card:hover .category-icon-box {
      background: var(--accent-cyan);
      color: var(--bg-dark);
      box-shadow: 0 0 15px var(--accent-cyan);
    }

    .category-icon-box i {
      font-size: 1.75rem;
    }

    .category-title {
      font-size: 1.05rem;
      font-weight: 600;
      margin-bottom: 4px;
      color: #fff;
    }

    .category-count {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .category-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: 4px;
      background: rgba(255, 42, 75, 0.2);
      color: var(--accent-red);
      border: 1px solid var(--accent-red);
    }

    .product-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      overflow: hidden;
      height: 100%;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
      position: relative;
    }

    .product-card:hover {
      border-color: var(--accent-red);
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }

    .product-img-box {
      background: #0d121c;
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .product-img-box img {
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    .product-card:hover .product-img-box img {
      transform: scale(1.08);
    }

    .product-body {
      padding: 18px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .product-badge-pill {
      position: absolute;
      top: 12px;
      left: 12px;
      background-color: var(--accent-red);
      color: white;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 3px;
      text-transform: uppercase;
    }

    .btn-add-cart {
      background: transparent;
      border: 1px solid var(--accent-cyan);
      color: var(--accent-cyan);
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-add-cart:hover {
      background-color: var(--accent-cyan);
      color: var(--bg-dark);
    }

    footer {
      background-color: var(--bg-surface);
      border-top: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="#" class="brand-logo"> PHeripheral <span>INC</span></a>
      
      <div class="d-none d-md-flex align-items-center gap-4">
        <a href="#" class="nav-link-custom active"><i class="bi bi-house-door me-1"></i> Home</a>
        <a href="#categories" class="nav-link-custom"><i class="bi bi-grid me-1"></i> Categories</a>
        <a href="#products" class="nav-link-custom"><i class="bi bi-cpu me-1"></i> Gear</a>
        <a href="#" class="nav-link-custom"><i class="bi bi-wrench-adjustable me-1"></i> PC Builder</a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <a href="/login" class="nav-link-custom d-none d-sm-inline-flex align-items-center">
          <i class="bi bi-person me-1"></i> LOGIN
        </a>
        <button class="btn btn-cyber py-2 px-3 fs-6">
          <i class="bi bi-cart3 fs-5"></i>
          <span class="d-none d-sm-inline">CART</span>
        </button>
      </div>
    </div>
  </nav>

  <header class="hero-banner">
    <div class="container text-center">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <span class="badge bg-danger mb-3 px-3 py-2 text-uppercase tracking-wide fs-7">Official Tech Reseller</span>
          <h1 class="hero-title mb-3"><%= hero.title %></h1>
          <p class="text-secondary fs-5 mb-4"><%= hero.subtitle %></p>
          <a href="<%= hero.ctaLink %>" class="btn-cyber">
            <%= hero.ctaText %> <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </header>

  <section id="categories" class="py-5">
    <div class="container my-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="section-header m-0">BROWSE CATEGORIES</h2>
          <p class="text-secondary small mt-2 m-0">Find components by hardware category</p>
        </div>
      </div>

      <!-- Minimal Bootstrap Grid Row -->
      <div class="row g-3">
        <% categories.forEach(category => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <div class="category-card">
              <% if(category.badge) { %>
                <span class="category-badge"><%= category.badge %></span>
              <% } %>
              
              <!-- Bootstrap Icon container -->
              <div class="category-icon-box">
                <i class="bi <%= category.icon %>"></i>
              </div>
              
              <h3 class="category-title"><%= category.name %></h3>
              <div class="category-count"><i class="bi bi-layers me-1"></i><%= category.itemCount %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section id="products" class="py-5" style="background: var(--bg-surface);">
    <div class="container my-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="section-header m-0">FEATURED HARDWARE</h2>
          <p class="text-secondary small mt-2 m-0">Authentic gaming hardware with store warranty</p>
        </div>
      </div>

      <!-- Minimal Bootstrap Grid Row for Products -->
      <div class="row g-4">
        <% products.forEach(product => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="product-card">
              <% if(product.badge) { %>
                <span class="product-badge-pill"><%= product.badge %></span>
              <% } %>
              
              <div class="product-img-box">
                <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
              </div>

              <div class="product-body">
                <span class="text-uppercase small text-secondary mb-1 fw-bold"><%= product.category %></span>
                <h3 class="fs-6 fw-semibold mb-3 text-white"><%= product.name %></h3>
                
                <div class="mt-auto d-flex align-items-center justify-content-between pt-2">
                  <div>
                    <span class="fs-5 fw-bold text-info font-monospace"><%= product.price %></span>
                    <% if(product.oldPrice) { %>
                      <span class="text-muted text-decoration-line-through small ms-1"><%= product.oldPrice %></span>
                    <% } %>
                  </div>
                  <button class="btn-add-cart">
                    <i class="bi bi-cart-plus me-1"></i> Add
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <footer class="py-4 text-center">
    <div class="container">
      <p class="mb-1">&copy; 2026  PHripheral Concept. All rights reserved.</p>
      <small class="text-secondary">Powered by Node.js, Express, EJS & Bootstrap Icons CDN.</small>
    </div>
  </footer>

</body>
</html>