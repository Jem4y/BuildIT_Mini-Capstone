<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account | PHeripheral INC</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-utilities.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root {
      --bg-dark: #080b11;
      --bg-card: #151d2d;
      --accent-cyan: #00f0ff;
      --accent-red: #ff2a4b;
      --accent-glow: rgba(0, 240, 255, 0.15);
      --text-main: #f0f4f8;
      --text-muted: #8c9ba5;
      --border-color: #212c40;
      --font-heading: 'Rajdhani', sans-serif;
      --font-body: 'Inter', sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: flex;
      flex-direction: column;
      background:
        radial-gradient(circle at 15% 20%, rgba(0, 240, 255, 0.08), transparent 35%),
        radial-gradient(circle at 85% 80%, rgba(255, 42, 75, 0.08), transparent 35%),
        var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-body);
    }

    .itech-navbar {
      background: rgba(8, 11, 17, 0.9);
      border-bottom: 1px solid var(--border-color);
    }

    .brand-logo {
      color: #fff;
      font-family: var(--font-heading);
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-decoration: none;
    }

    .brand-logo span {
      color: var(--accent-red);
    }

    .nav-link-custom {
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 500;
      text-decoration: none;
    }

    .nav-link-custom:hover,
    .register-footer a:hover {
      color: var(--accent-cyan);
    }

    .register-shell {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 56px 16px;
    }

    .register-card {
      width: min(100%, 480px);
      padding: 40px;
      background: rgba(21, 29, 45, 0.94);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
    }

    .register-mark {
      width: 56px;
      height: 56px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      border: 1px solid rgba(0, 240, 255, 0.35);
      border-radius: 10px;
      background: rgba(0, 240, 255, 0.08);
      color: var(--accent-cyan);
      font-size: 1.6rem;
    }

    .register-title {
      margin: 0 0 8px;
      font-family: var(--font-heading);
      font-size: 2.5rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .register-subtitle {
      margin: 0 0 28px;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .form-label {
      display: block;
      margin-bottom: 8px;
      color: #dbe5ec;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .form-control {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      outline: none;
      background: #0d121c;
      color: var(--text-main);
      font: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .form-control::placeholder {
      color: #667684;
    }

    .terms {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin: 20px 0;
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.5;
    }

    .terms input {
      margin-top: 3px;
      accent-color: var(--accent-cyan);
    }

    .terms a,
    .register-footer a {
      color: var(--accent-cyan);
      text-decoration: none;
    }

    .btn-cyber {
      width: 100%;
      padding: 13px 20px;
      border: 0;
      border-radius: 6px;
      background: var(--accent-cyan);
      color: var(--bg-dark);
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      box-shadow: 0 0 20px var(--accent-glow);
      transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .btn-cyber:hover {
      background: #fff;
      transform: translateY(-2px);
    }

    .register-footer {
      margin: 26px 0 0;
      color: var(--text-muted);
      font-size: 0.9rem;
      text-align: center;
    }

    @media (max-width: 420px) {
      .register-card {
        padding: 30px 22px;
      }
    }
  </style>
</head>
<body>
  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">PHeripheral <span>INC</span></a>
      <a href="/" class="nav-link-custom">
        <i class="bi bi-arrow-left me-1"></i> BACK TO STORE
      </a>
    </div>
  </nav>

  <main class="register-shell">
    <section class="register-card" aria-labelledby="register-title">
      <div class="text-center">
        <div class="register-mark" aria-hidden="true">
          <i class="bi bi-person-plus"></i>
        </div>
        <h1 id="register-title" class="register-title">Create account</h1>
        <p class="register-subtitle">Join PHeripheral and start building your ultimate setup.</p>
      </div>

      <form action="/register" method="post">
        <div class="mb-3">
          <label class="form-label" for="name">FULL NAME</label>
          <input class="form-control" id="name" name="name" type="text" autocomplete="name" placeholder="Your full name" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="email">EMAIL ADDRESS</label>
          <input class="form-control" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="password">PASSWORD</label>
          <input class="form-control" id="password" name="password" type="password" autocomplete="new-password" minlength="8" placeholder="At least 8 characters" required>
        </div>

        <div>
          <label class="form-label" for="confirm-password">CONFIRM PASSWORD</label>
          <input class="form-control" id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Re-enter your password" required>
        </div>

        <label class="terms">
          <input type="checkbox" name="terms" value="accepted" required>
          <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</span>
        </label>

        <button type="submit" class="btn-cyber">Create account <i class="bi bi-arrow-right ms-1"></i></button>
      </form>

      <p class="register-footer">Already have an account? <a href="/login">Sign in</a></p>
    </section>
  </main>
</body>
</html>
