<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BuildIT | Gaming Hardware & Custom Rigs</title>

  <!-- Gamer Theme CSS -->
  <link rel="stylesheet" href="/style.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >
</head>

<body>

  <!-- NAVBAR -->
  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">

      <a href="/" class="brand-logo">
        BuildIT <span>INC</span>
      </a>

      <!-- NAVIGATION LINKS -->
      <div class="nav-links d-none d-md-flex align-items-center">
        <a href="/" class="nav-link-custom active">
          <i class="bi bi-house-door"></i> Home
        </a>
        <!-- CATEGORIES DROPDOWN -->
        <div class="nav-dropdown">
          <button type="button" class="nav-link-custom nav-dropdown-toggle<%= selectedCategory ? ' active' : '' %>"
                  aria-haspopup="true" aria-expanded="false" aria-controls="categoryMenu">
            <i class="bi bi-grid"></i> Categories
            <i class="bi bi-chevron-down nav-caret"></i>
          </button>
          <ul class="nav-dropdown-menu" id="categoryMenu">
            <li>
              <a href="/#products" class="<%= selectedCategory ? '' : 'current' %>">
                <i class="bi bi-collection"></i> All products
              </a>
            </li>
            <% categories.forEach(cat => { %>
              <li>
                <a href="/?category=<%= encodeURIComponent(cat.name) %>#products"
                   class="<%= selectedCategory === cat.name ? 'current' : '' %>">
                  <i class="bi <%= cat.icon || 'bi-box' %>"></i> <%= cat.name %>
                </a>
              </li>
            <% }) %>
          </ul>
        </div>
        <a href="/#products" class="nav-link-custom">
          <i class="bi bi-cpu"></i> Gear
        </a>
        <a href="/pcbuild" class="nav-link-custom text-info">
          <i class="bi bi-tools"></i> PC Builder
        </a>
      </div>

      <div class="nav-actions d-flex align-items-center">
        <!-- ACCOUNT DROPDOWN -->
        <div class="nav-dropdown nav-dropdown-right">
          <button type="button" class="nav-link-custom nav-dropdown-toggle<%= user ? ' is-user' : '' %>"
                  aria-haspopup="true" aria-expanded="false" aria-controls="accountMenu">
            <i class="bi <%= user ? 'bi-controller' : 'bi-person' %>"></i>
            <span class="nav-user d-none d-sm-inline"><%= user ? user : 'Account' %></span>
            <i class="bi bi-chevron-down nav-caret"></i>
          </button>
          <ul class="nav-dropdown-menu" id="accountMenu">
            <% if (user) { %>
              <li><a href="/cart"><i class="bi bi-cart3"></i> My cart</a></li>
              <li><a href="/pcbuild"><i class="bi bi-tools"></i> PC builder</a></li>
              <li><a href="/logout" class="danger"><i class="bi bi-box-arrow-right"></i> Log out</a></li>
            <% } else { %>
              <li><a href="/login"><i class="bi bi-box-arrow-in-right"></i> Log in</a></li>
              <li><a href="/register"><i class="bi bi-person-plus"></i> Create account</a></li>
            <% } %>
          </ul>
        </div>

        <a href="/cart" class="btn-cyber py-2 px-3 fs-6">
          <i class="bi bi-cart3 fs-5"></i>
          <span class="d-none d-sm-inline">CART</span>
        </a>

        <!-- MOBILE MENU BUTTON (phones and small tablets only) -->
        <button type="button" class="nav-mobile-toggle" aria-label="Open menu"
                aria-expanded="false" aria-controls="mobileMenu">
          <i class="bi bi-list icon-open"></i>
          <i class="bi bi-x-lg icon-close"></i>
        </button>
      </div>

    </div>

    <!-- MOBILE MENU -->
    <div class="mobile-menu" id="mobileMenu">
      <a href="/" class="mobile-link"><i class="bi bi-house-door"></i> Home</a>

      <details class="mobile-details"<%= selectedCategory ? ' open' : '' %>>
        <summary class="mobile-link"><i class="bi bi-grid"></i> Categories <i class="bi bi-chevron-down mobile-caret"></i></summary>
        <div class="mobile-sub">
          <a href="/#products" class="<%= selectedCategory ? '' : 'current' %>"><i class="bi bi-collection"></i> All products</a>
          <% categories.forEach(cat => { %>
            <a href="/?category=<%= encodeURIComponent(cat.name) %>#products"
               class="<%= selectedCategory === cat.name ? 'current' : '' %>">
              <i class="bi <%= cat.icon || 'bi-box' %>"></i> <%= cat.name %>
            </a>
          <% }) %>
        </div>
      </details>

      <a href="/#products" class="mobile-link"><i class="bi bi-cpu"></i> Gear</a>
      <a href="/pcbuild" class="mobile-link"><i class="bi bi-tools"></i> PC Builder</a>
    </div>
  </nav>


  <!-- HERO -->
  <header class="hero-banner">
    <div class="container text-center">
      <div class="row justify-content-center">
        <div class="col-lg-8">

          <span class="category-badge position-relative d-inline-block mb-3 px-3 py-2">
            OFFICIAL TECH RESELLER
          </span>

          <h1 class="hero-title mb-3">
            <%= hero?.title || "LEVEL UP YOUR GEAR" %>
          </h1>

          <p class="text-secondary fs-5 mb-4">
            <%= hero?.subtitle || "Build your ultimate gaming setup with high-performance hardware." %>
          </p>

          <div class="hero-actions d-flex justify-content-center gap-3 flex-wrap">
            <a href="<%= hero?.ctaLink || '#products' %>" class="btn-cyber">
              <%= hero?.ctaText || "EXPLORE CATALOG" %>
              <i class="bi bi-arrow-right"></i>
            </a>

            <!-- PC BUILDER HERO BUTTON -->
            <a href="/pcbuild" class="btn-cyber" style="background: linear-gradient(135deg, var(--accent-magenta), #e0004c); color: #fff;">
              SYSTEM BUILDER
              <i class="bi bi-tools"></i>
            </a>
          </div>

        </div>
      </div>
    </div>
  </header>


  <!-- PC BUILDER FEATURE BANNER -->
  <section class="py-5" style="background: rgba(0, 240, 255, 0.03); border-bottom: 1px solid var(--border-color);">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <span class="text-info fw-bold small text-uppercase" style="letter-spacing: 2px;">
            <i class="bi bi-cpu-fill me-1"></i> CUSTOM RIG CONFIGURATOR
          </span>
          <h2 class="fs-2 font-monospace fw-bold text-white mt-2 mb-2">
            BUILD YOUR CUSTOM PC LOADOUT
          </h2>
          <p class="text-secondary m-0">
            Pick compatible Processors, Graphics Cards, Motherboards, and RAM memory to configure a high-performance gaming desktop and add the whole rig directly to your cart.
          </p>
        </div>
        <div class="col-lg-4 text-lg-end">
          <a href="/pcbuild" class="btn-cyber py-3 px-4">
            LAUNCH BUILDER <i class="bi bi-wrench-adjustable ms-1"></i>
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- CATEGORIES -->
  <section id="categories" class="py-5">
    <div class="container my-4">

      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h2 class="section-header m-0">BROWSE CATEGORIES</h2>
          <p class="text-secondary small mt-2 m-0">Equip your build with core components</p>
        </div>
      </div>

      <div class="row g-3">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(category => { %>
            <div class="col-6 col-md-4 col-lg-3">
              <a href="/?category=<%= encodeURIComponent(category.name) %>#products" class="category-link">
                <div class="category-card">

                  <% if (category.badge) { %>
                    <span class="category-badge"><%= category.badge %></span>
                  <% } %>

                  <div class="category-icon-box">
                    <i class="bi <%= category.icon || 'bi-box' %>"></i>
                  </div>

                  <h3 class="category-title"><%= category.name %></h3>

                  <div class="text-secondary small">
                    <i class="bi bi-layers me-1"></i> <%= category.itemCount || "Products" %>
                  </div>

                </div>
              </a>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12">
            <div class="text-secondary text-center py-5">No categories available.</div>
          </div>
        <% } %>
      </div>

    </div>
  </section>


  <!-- PRODUCTS -->
  <section id="products" class="py-5" style="background: var(--bg-surface);">
    <div class="container my-4">

      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
          <h2 class="section-header m-0"><%= selectedCategory ? selectedCategory.toUpperCase() : 'FEATURED HARDWARE' %></h2>
          <p class="text-secondary small mt-2 m-0">
            <% if (selectedCategory) { %>
              <%= products.length %> item<%= products.length === 1 ? '' : 's' %> in this category &middot; <a href="/#products" class="clear-filter">Show all</a>
            <% } else { %>
              Verified hardware with warranty
            <% } %>
          </p>
        </div>

        <div class="mt-3 mt-md-0">
          <form method="GET" action="/#products">
            <% if (selectedCategory) { %>
              <input type="hidden" name="category" value="<%= selectedCategory %>">
            <% } %>
            <select
              name="sort"
              class="form-select bg-dark text-white border-secondary p-2 rounded"
              style="font-family: var(--font-heading); letter-spacing: 1px;"
              onchange="this.form.submit()"
            >
              <option value="" <%= sort === '' ? 'selected' : '' %>>Sort by Price</option>
              <option value="low" <%= sort === 'low' ? 'selected' : '' %>>Lowest Price</option>
              <option value="high" <%= sort === 'high' ? 'selected' : '' %>>Highest Price</option>
            </select>
          </form>
        </div>
      </div>

      <div class="row g-4">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <div class="col-12 col-sm-6 col-lg-4">
              <div class="product-card">

                <% if (product.badge) { %>
                  <span class="product-badge-pill"><%= product.badge %></span>
                <% } %>

                <div class="product-img-box">
                  <img
                    src="<%= product.image || '/images/no-image.png' %>"
                    alt="<%= product.name %>"
                    loading="lazy"
                  >
                </div>

                <div class="product-body">
                  <span class="text-uppercase small text-secondary mb-1 fw-bold">
                    <%= product.category || "Hardware" %>
                  </span>

                  <h3 class="fs-6 fw-semibold mb-3 text-white">
                    <%= product.name %>
                  </h3>

                  <div class="mt-auto d-flex align-items-center justify-content-between pt-2">
                    <div>
                      <span class="fs-5 fw-bold text-info font-monospace">
                        ₱<%= Number(product.price).toLocaleString() %>
                      </span>

                      <% if (product.oldPrice) { %>
                        <span class="text-muted text-decoration-line-through small ms-1">
                          ₱<%= Number(product.oldPrice).toLocaleString() %>
                        </span>
                      <% } %>
                    </div>

                    <form action="/cart/add" method="POST">
                      <input type="hidden" name="productId" value="<%= product.id %>">
                      <button type="submit" class="btn-add-cart">
                        <i class="bi bi-cart-plus me-1"></i> Add
                      </button>
                    </form>
                  </div>

                </div>

              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center text-secondary py-5">
            <i class="bi bi-box-seam fs-1"></i>
            <p class="mt-3"><%= selectedCategory ? 'No products in this category yet.' : 'No products available.' %></p>
          </div>
        <% } %>
      </div>

    </div>
  </section>


  <!-- FOOTER -->
  <footer class="py-4 text-center">
    <div class="container">
      <p class="mb-1">&copy; 2026 BuildIT INC. All rights reserved.</p>
      <small class="text-secondary">Powered by Node.js, Express, EJS & MySQL.</small>
    </div>
  </footer>

  <script>
    // Navbar menus.
    //  - Desktop dropdowns (.nav-dropdown): hover or click/tap opens them.
    //  - Mobile menu (.nav-mobile-toggle -> #mobileMenu): shown below 768px.
    // Esc or a click outside closes everything.
    (function () {
      const dropdowns = document.querySelectorAll('.nav-dropdown');
      const mobileToggle = document.querySelector('.nav-mobile-toggle');
      const mobileMenu = document.getElementById('mobileMenu');
      const navbar = document.querySelector('.itech-navbar');

      function closeDropdowns(except) {
        dropdowns.forEach((d) => {
          if (d === except) return;
          d.classList.remove('open');
          d.querySelector('.nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
      }

      function setMobile(open) {
        if (!mobileToggle || !mobileMenu) return;
        mobileMenu.classList.toggle('open', open);
        mobileToggle.setAttribute('aria-expanded', String(open));
        mobileToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      }

      dropdowns.forEach((d) => {
        const toggle = d.querySelector('.nav-dropdown-toggle');
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const willOpen = !d.classList.contains('open');
          setMobile(false);
          closeDropdowns(d);
          d.classList.toggle('open', willOpen);
          toggle.setAttribute('aria-expanded', String(willOpen));
        });
      });

      if (mobileToggle && mobileMenu) {
        mobileToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          closeDropdowns();
          setMobile(!mobileMenu.classList.contains('open'));
        });

        // Tapping a link closes the menu (needed for same-page #anchors)
        mobileMenu.addEventListener('click', (e) => {
          if (e.target.closest('a')) setMobile(false);
        });

        // If the window grows to desktop width, make sure the mobile menu is closed
        window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
          if (e.matches) setMobile(false);
        });
      }

      document.addEventListener('click', (e) => {
        closeDropdowns();
        if (!navbar || !navbar.contains(e.target)) setMobile(false);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const openDropdown = document.querySelector('.nav-dropdown.open');
        const mobileWasOpen = mobileMenu && mobileMenu.classList.contains('open');
        closeDropdowns();
        setMobile(false);
        if (openDropdown) openDropdown.querySelector('.nav-dropdown-toggle').focus();
        else if (mobileWasOpen) mobileToggle.focus();
      });
    })();
  </script>
</body>
</html>