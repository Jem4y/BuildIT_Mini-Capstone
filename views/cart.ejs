<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Inventory & Cart | BuildIT</title>

  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="pcbuilder.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap"
    rel="stylesheet"
  >

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >
</head>

<body>

  <!-- NAVBAR -->
  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">BuildIT <span>INC</span></a>
      <a href="/" class="nav-link-custom">
        <i class="bi bi-arrow-left me-1"></i> Back to Store
      </a>
    </div>
  </nav>

  <div class="builder-shell">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="builder-title m-0">YOUR SHOPPING CART</h1>
      <% if (userName) { %>
        <span class="category-badge">PILOT: <%= userName %></span>
      <% } %>
    </div>

    <div class="builder-grid">

      <!-- ITEM LIST -->
      <div class="board-card">
        <span class="section-label">SELECTED HARDWARE LOADOUT</span>

        <div class="component-list">
          <% if (cart && cart.length > 0) { %>
            <% cart.forEach(item => { %>
              <div class="component-item">

                <div class="component-icon">
                  <i class="bi bi-cpu"></i>
                </div>

                <div class="component-meta">
                  <div class="component-name"><%= item.name %></div>
                  <span class="component-specs">
                    ₱<%= Number(item.price).toLocaleString() %> each
                    <% if (item.quantity >= item.stock) { %> · MAX STOCK REACHED<% } %>
                  </span>

                  <div class="qty-control">
                    <form action="/cart/update" method="POST">
                      <input type="hidden" name="cartItemId" value="<%= item.id %>">
                      <input type="hidden" name="action" value="decrease">
                      <button type="submit" class="qty-btn" aria-label="Decrease quantity">
                        <i class="bi bi-dash"></i>
                      </button>
                    </form>

                    <span class="qty-value"><%= item.quantity %></span>

                    <form action="/cart/update" method="POST">
                      <input type="hidden" name="cartItemId" value="<%= item.id %>">
                      <input type="hidden" name="action" value="increase">
                      <button type="submit" class="qty-btn" aria-label="Increase quantity"
                        <%= item.quantity >= item.stock ? 'disabled' : '' %>>
                        <i class="bi bi-plus"></i>
                      </button>
                    </form>
                  </div>
                </div>

                <div class="component-side">
                  <div class="component-price">
                    ₱<%= Number(item.subtotal).toLocaleString() %>
                  </div>

                  <form action="/cart/remove" method="POST"
                        onsubmit="return confirm('Remove this item from your cart?');">
                    <input type="hidden" name="cartItemId" value="<%= item.id %>">
                    <button type="submit" class="remove-btn">
                      <i class="bi bi-trash3"></i> Remove
                    </button>
                  </form>
                </div>

              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-5 text-muted">Your cart inventory is currently empty.</div>
          <% } %>
        </div>
      </div>

      <!-- CHECKOUT SUMMARY -->
      <div class="summary-card">
        <div class="summary-header">
          <h2 class="summary-title">ORDER OVERVIEW</h2>
          <span class="budget-pill">VERIFIED</span>
        </div>

        <ul class="price-list">
          <li class="price-row">
            <span>Items Count:</span>
            <strong><%= cart ? cart.reduce((n, i) => n + Number(i.quantity), 0) : 0 %></strong>
          </li>
          <li class="price-row">
            <span>Shipping:</span>
            <strong class="text-success">CALCULATED AT CHECKOUT</strong>
          </li>
        </ul>

        <div class="total-box">
          <span class="total-label">TOTAL AMOUNT:</span>
          <span class="total-value">₱<%= Number(total).toLocaleString() %></span>
        </div>

        <% if (cart && cart.length > 0) { %>
          <a href="/checkout" class="btn-cyber w-100 py-3 text-center justify-content-center">
            PROCEED TO CHECKOUT <i class="bi bi-credit-card ms-2"></i>
          </a>
        <% } else { %>
          <button class="btn-cyber w-100 py-3 text-center justify-content-center" disabled style="opacity:.5;cursor:not-allowed;">
            PROCEED TO CHECKOUT <i class="bi bi-credit-card ms-2"></i>
          </button>
        <% } %>

        <p class="pay-note" style="margin: 14px 0 0; color: var(--text-muted); font-size: 0.8rem;">
          <i class="bi bi-wallet2 me-1"></i> Pay by Debit Card, E-Wallet (GCash, Maya...) or Cash on Delivery.
        </p>
      </div>

    </div>
  </div>

</body>
</html>