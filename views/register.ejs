<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | BuildIT</title>
  <link rel="stylesheet" href="register.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body>

  <nav class="itech-navbar p-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">BuildIT <span>INC</span></a>
    </div>
  </nav>

  <div class="register-shell">
    <div class="register-card">
      <div class="register-mark"><i class="bi bi-person-plus"></i></div>
      <h1 class="register-title">REGISTER</h1>
      <p class="register-subtitle">Create a new BuildIT user account.</p>

      <% if (error) { %>
        <div style="color: var(--accent-red); margin-bottom: 15px; font-weight: 600;"><%= error %></div>
      <% } %>

      <form action="/register" method="POST">
        <div style="margin-bottom: 16px;">
          <label class="form-label">FULL NAME</label>
          <input type="text" name="name" class="form-control" placeholder="John Doe" required>
        </div>

        <div style="margin-bottom: 16px;">
          <label class="form-label">EMAIL ADDRESS</label>
          <input type="email" name="email" class="form-control" placeholder="john@example.com" required>
        </div>

        <div style="margin-bottom: 16px;">
          <label class="form-label">PASSWORD</label>
          <input type="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>

        <div style="margin-bottom: 16px;">
          <label class="form-label">CONFIRM PASSWORD</label>
          <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required>
        </div>

        <div class="terms">
          <input type="checkbox" name="terms" id="terms" required>
          <label for="terms">I agree to the Terms of Service & Privacy Policy</label>
        </div>

        <button type="submit" class="btn-cyber">CREATE ACCOUNT</button>
      </form>

      <div class="register-footer">
        Already registered? <a href="/login">Sign In</a>
      </div>
    </div>
  </div>

</body>
</html>