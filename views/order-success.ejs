<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order Confirmed | BuildIT</title>

  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/pcbuilder.css">
  <link rel="stylesheet" href="/checkout.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >
</head>

<body>

  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">BuildIT <span>INC</span></a>
      <a href="/" class="nav-link-custom">
        <i class="bi bi-arrow-left me-1"></i> Back to Store
      </a>
    </div>
  </nav>

  <div class="builder-shell">
    <div class="order-banner">
      <div class="order-check"><i class="bi bi-check-lg"></i></div>
      <div>
        <h1 class="builder-title m-0">ORDER CONFIRMED</h1>
        <p class="order-sub">
          Thanks, <%= order.full_name %>! Your order number is <strong><%= orderNo %></strong>.
        </p>
      </div>
    </div>

    <div class="builder-grid">

      <div class="checkout-main">

        <div class="board-card">
          <span class="section-label">ITEMS ORDERED</span>
          <ul class="summary-items">
            <% items.forEach(item => { %>
              <li>
                <span class="summary-item-name"><%= item.name %> <em>&times; <%= item.quantity %></em></span>
                <strong>&#8369;<%= Number(item.price * item.quantity).toLocaleString() %></strong>
              </li>
            <% }) %>
          </ul>
        </div>

        <div class="board-card">
          <span class="section-label">DELIVERING TO</span>
          <p class="order-text">
            <strong><%= order.full_name %></strong><br>
            <%= order.phone %><br>
            <%= order.street %>, Brgy. <%= order.barangay %><br>
            <%= order.city %>, <%= order.province %> <%= order.postal_code %><br>
            <%= regionName %>
          </p>
        </div>

      </div>

      <div class="summary-card">
        <div class="summary-header">
          <h2 class="summary-title">PAYMENT</h2>
          <span class="budget-pill"><%= order.payment_status.toUpperCase() %></span>
        </div>

        <ul class="price-list">
          <li class="price-row">
            <span>Method:</span>
            <strong><%= paymentLabel %></strong>
          </li>
          <% if (order.payment_reference) { %>
            <li class="price-row">
              <span>Details:</span>
              <strong><%= order.payment_reference %></strong>
            </li>
          <% } %>
          <li class="price-row">
            <span>Subtotal:</span>
            <strong>&#8369;<%= Number(order.subtotal).toLocaleString() %></strong>
          </li>
          <li class="price-row">
            <span>Shipping:</span>
            <strong><%= Number(order.shipping_fee) === 0 ? 'FREE' : '\u20B1' + Number(order.shipping_fee).toLocaleString() %></strong>
          </li>
        </ul>

        <div class="total-box">
          <span class="total-label"><%= order.payment_method === 'cod' ? 'PAY ON DELIVERY:' : 'TOTAL PAID:' %></span>
          <span class="total-value">&#8369;<%= Number(order.total).toLocaleString() %></span>
        </div>

        <% if (order.payment_method === 'cod') { %>
          <p class="pay-note" style="margin: 0 0 16px;">
            <i class="bi bi-cash-coin me-1"></i>Please prepare the exact amount in cash for the courier.
          </p>
        <% } %>

        <a href="/" class="btn-cyber w-100 py-3 text-center justify-content-center">
          CONTINUE SHOPPING <i class="bi bi-arrow-right ms-2"></i>
        </a>
      </div>

    </div>
  </div>

</body>
</html>
