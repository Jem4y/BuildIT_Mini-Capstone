<%
  /* View helpers */
  const money = n => '₱' + Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const date = d => new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const stockPill = s => s === 0 ? ['bad', 'Out of stock'] : s <= 5 ? ['warn', 'Low stock'] : ['ok', 'In stock'];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin | BuildIT</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
  <div class="admin-layout">

    <%- include('admin-sidebar', { admin }) %>

    <div class="main">
      <header class="topbar">
        <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
          <i class="bi bi-list"></i>
        </button>
        <h1 class="topbar-title">Admin dashboard</h1>
        <div class="topbar-actions">
          <button class="btn btn-primary" id="openAdd"><i class="bi bi-plus-lg"></i><span>Add product</span></button>
        </div>
      </header>

      <main class="content">

        <% if (flash) { %>
          <div class="flash <%= flash.type %>" role="status"><%= flash.text %></div>
        <% } %>

        <!-- Overview -->
        <section id="overview" class="stats" aria-label="Store overview">
          <article class="stat-card">
            <span class="stat-icon"><i class="bi bi-box-seam"></i></span>
            <div><span class="stat-value"><%= stats.products.toLocaleString() %></span><span class="stat-label">Products</span></div>
          </article>
          <article class="stat-card green">
            <span class="stat-icon"><i class="bi bi-people"></i></span>
            <div><span class="stat-value"><%= stats.customers.toLocaleString() %></span><span class="stat-label">Registered users</span></div>
          </article>
          <article class="stat-card magenta">
            <span class="stat-icon"><i class="bi bi-exclamation-triangle"></i></span>
            <div><span class="stat-value"><%= stats.lowStock.toLocaleString() %></span><span class="stat-label">Low or out of stock</span></div>
          </article>
          <article class="stat-card gold">
            <span class="stat-icon"><i class="bi bi-cart3"></i></span>
            <div><span class="stat-value"><%= money(stats.cartValue) %></span><span class="stat-label">Value in carts</span></div>
          </article>
        </section>

        <!-- Products -->
        <section id="products" class="panel">
          <div class="panel-header">
            <h2 class="panel-title">Products</h2>
            <div class="search">
              <i class="bi bi-search"></i>
              <input type="search" class="input" id="productSearch" placeholder="Search products" aria-label="Search products">
            </div>
          </div>
          <div class="table-wrap">
            <table class="table" id="productTable">
              <thead>
                <tr><th>Product</th><th>Category</th><th class="num">Price</th><th class="num">Stock</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr>
              </thead>
              <tbody>
                <% products.forEach(p => { const [cls, label] = stockPill(p.stock); %>
                  <tr>
                    <td data-label="Product">
                      <div class="product-cell">
                        <span class="product-thumb"><img src="<%= p.image %>" alt="" loading="lazy"></span>
                        <%= p.name %>
                      </div>
                    </td>
                    <td data-label="Category"><%= p.category %></td>
                    <td data-label="Price" class="num price">
                      <%= money(p.price) %>
                      <% if (p.oldPrice) { %><span class="old-price"><%= money(p.oldPrice) %></span><% } %>
                    </td>
                    <td data-label="Stock" class="num"><%= p.stock %></td>
                    <td data-label="Status"><span class="pill <%= cls %>"><%= label %></span></td>
                    <td class="no-label">
                      <div class="row-actions">
                        <button type="button" class="icon-btn js-edit" aria-label="Edit <%= p.name %>"
                          data-id="<%= p.id %>"
                          data-name="<%= p.name %>"
                          data-category="<%= p.category %>"
                          data-price="<%= p.price %>"
                          data-old-price="<%= p.oldPrice || '' %>"
                          data-stock="<%= p.stock %>"
                          data-image="<%= p.image %>"
                          data-badge="<%= p.badge || '' %>"><i class="bi bi-pencil"></i></button>
                        <form action="/admin/products/<%= p.id %>/delete" method="post" data-confirm="Delete &quot;<%= p.name %>&quot;? This also removes it from customers' carts.">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button class="icon-btn danger" aria-label="Delete <%= p.name %>"><i class="bi bi-trash"></i></button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <p class="empty <%= products.length ? '' : 'show' %>" id="productEmpty">
              <%= products.length ? 'No products match your search.' : 'No products yet. Add your first one.' %>
            </p>
          </div>
        </section>

        <!-- Customers -->
        <section id="customers" class="panel">
          <div class="panel-header">
            <h2 class="panel-title">Newest users</h2>
          </div>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Name</th><th>Email</th><th>Joined</th><th class="num">Items in cart</th></tr>
              </thead>
              <tbody>
                <% customers.forEach(c => { %>
                  <tr>
                    <td data-label="Name"><%= c.full_name %></td>
                    <td data-label="Email"><%= c.email %></td>
                    <td data-label="Joined"><%= date(c.created_at) %></td>
                    <td data-label="Items in cart" class="num"><%= c.cart_items %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <% if (!customers.length) { %><p class="empty show">No users yet.</p><% } %>
          </div>
        </section>

      </main>
    </div>
  </div>

  <!-- Add / edit product dialog -->
  <dialog class="modal" id="productDialog" aria-labelledby="dialogTitle">
    <form id="productForm" action="/admin/products" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2 class="modal-title" id="dialogTitle">Add product</h2>

      <div class="field">
        <label for="pName">Name</label>
        <input class="input" id="pName" name="name" required maxlength="255" placeholder="e.g. NVIDIA GeForce RTX 4070 Super">
      </div>

      <div class="field">
        <label for="pCategory">Category</label>
        <select class="input" id="pCategory" name="category" required>
          <% categories.forEach(c => { %>
            <option><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="pPrice">Price (₱)</label>
          <input class="input" id="pPrice" name="price" type="number" min="0" step="0.01" required inputmode="decimal">
        </div>
        <div class="field">
          <label for="pOldPrice">Old price (₱)</label>
          <input class="input" id="pOldPrice" name="oldPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Optional">
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="pStock">Stock</label>
          <input class="input" id="pStock" name="stock" type="number" min="0" step="1" required inputmode="numeric">
        </div>
        <div class="field">
          <label for="pBadge">Badge</label>
          <input class="input" id="pBadge" name="badge" maxlength="50" placeholder="e.g. NEW">
        </div>
      </div>

      <div class="field">
        <label for="pImage">Image URL</label>
        <input class="input" id="pImage" name="image" maxlength="255" placeholder="https://… or /images/photo.png">
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" id="cancelDialog">Cancel</button>
        <button type="submit" class="btn btn-primary">Save product</button>
      </div>
    </form>
  </dialog>

  <script src="/admin.js"></script>
</body>
</html>
