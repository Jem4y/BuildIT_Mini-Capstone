<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PC Builder | PHeripheral INC</title>

  <link rel ="stylesheet" href="pcbuilder.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-utilities.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
 
</head>
<body>
  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">PHeripheral <span>INC</span></a>
      <div class="d-flex align-items-center gap-3">
        <a href="/" class="nav-link-custom"><i class="bi bi-house-door me-1"></i> HOME</a>
        <a href="/login" class="nav-link-custom"><i class="bi bi-person me-1"></i> LOGIN</a>
      </div>
    </div>
  </nav>

  <main class="builder-shell">
    <section class="builder-hero">
      <span class="eyebrow"><i class="bi bi-cpu me-2"></i> Custom Build Studio</span>
      <h1 class="builder-title">Build Your Dream Rig</h1>
      <p class="builder-subtitle">Design a high-performance gaming or creator setup with balanced power, speed, and efficiency. Pick the right CPU, GPU, and peripherals for the perfect play experience.</p>
    </section>

    <section class="builder-grid">
      <div class="board-card">
        <span class="section-label">Selected Components</span>

        <div class="component-list">
          <div class="component-item">
            <div class="component-icon"><i class="bi bi-cpu"></i></div>
            <div class="component-meta">
              <div class="component-name">AMD Ryzen 7 7800X3D</div>
              <span class="component-specs">8-Core / 16-Thread • 5.0GHz Boost • AM5</span>
            </div>
            <div class="component-price">₱24,850</div>
          </div>

          <div class="component-item">
            <div class="component-icon"><i class="bi bi-gpu-card"></i></div>
            <div class="component-meta">
              <div class="component-name">NVIDIA RTX 4080 Super</div>
              <span class="component-specs">16GB GDDR6X • 4K Ready • DLSS 3.5</span>
            </div>
            <div class="component-price">₱68,995</div>
          </div>

          <div class="component-item">
            <div class="component-icon"><i class="bi bi-memory"></i></div>
            <div class="component-meta">
              <div class="component-name">32GB DDR5 RGB Kit</div>
              <span class="component-specs">6000MHz • 2x16GB • Dual Channel</span>
            </div>
            <div class="component-price">₱11,200</div>
          </div>

          <div class="component-item">
            <div class="component-icon"><i class="bi bi-hdd-stack"></i></div>
            <div class="component-meta">
              <div class="component-name">2TB NVMe Gen4 SSD</div>
              <span class="component-specs">7000MB/s • PCIe 4.0 • Heatsink</span>
            </div>
            <div class="component-price">₱8,450</div>
          </div>

          <div class="component-item">
            <div class="component-icon"><i class="bi bi-plug"></i></div>
            <div class="component-meta">
              <div class="component-name">850W 80+ Gold PSU</div>
              <span class="component-specs">Fully Modular • ATX 3.0 • Silent</span>
            </div>
            <div class="component-price">₱8,990</div>
          </div>
        </div>
      </div>

      <aside class="summary-card">
        <div class="summary-header">
          <h2 class="summary-title">Total</h2>
          <span class="budget-pill">Balanced</span>
        </div>

        <ul class="price-list">
          <li class="price-row"><span>CPU</span><strong>₱24,850</strong></li>
          <li class="price-row"><span>GPU</span><strong>₱68,995</strong></li>
          <li class="price-row"><span>Memory</span><strong>₱11,200</strong></li>
          <li class="price-row"><span>Storage</span><strong>₱8,450</strong></li>
          <li class="price-row"><span>PSU</span><strong>₱8,990</strong></li>
        </ul>

        <div class="total-box">
          <div>
            <div class="total-label">Estimated total</div>
          </div>
          <div class="total-value">₱122,485</div>
        </div>

        <div class="check-list">
          <div class="check-item"><i class="bi bi-check-circle-fill"></i> CPU & motherboard socket match</div>
          <div class="check-item"><i class="bi bi-check-circle-fill"></i> Cooling clearance verified</div>
          <div class="check-item"><i class="bi bi-check-circle-fill"></i> Power supply meets GPU requirement</div>
        </div>

        <button class="btn-cyber w-100">Finalize build</button>

        <div class="option-card">
          <span class="section-label">Suggested upgrades</span>
          <div class="option-grid">
            <div class="mini-option">AIO Cooler <small>₱6,990</small></div>
            <div class="mini-option">4K Monitor <small>₱28,500</small></div>
            <div class="mini-option">Mechanical KB <small>₱9,300</small></div>
            <div class="mini-option">RGB Case <small>₱7,800</small></div>
          </div>
        </div>
      </aside>
    </section>
  </main>
</body>
</html>
