<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Custom Rig Builder | BuildIT</title>

  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="pcbuilder.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body>

  <!-- NAVBAR -->
  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">BuildIT <span>INC</span></a>
      <div class="d-none d-md-flex align-items-center gap-4">
        <a href="/" class="nav-link-custom"><i class="bi bi-house-door me-1"></i> Home</a>
        <a href="/pcbuild" class="nav-link-custom active"><i class="bi bi-cpu me-1"></i> Rig Builder</a>
      </div>
      <div class="d-flex align-items-center gap-3">
        <a href="/cart" class="btn-cyber py-2 px-3 fs-6">
          <i class="bi bi-cart3 fs-5"></i>
          <span class="d-none d-sm-inline">CART</span>
        </a>
      </div>
    </div>
  </nav>

  <div class="builder-shell">
    <div class="builder-hero mb-4">
      <span class="eyebrow"><i class="bi bi-tools"></i> SYSTEM CONFIGURATOR</span>
      <h1 class="builder-title">CUSTOM RIG BUILDER</h1>
      <p class="builder-subtitle">Select your core hardware components to compile a complete custom desktop configuration.</p>
    </div>

    <form action="/pcbuild/add-all" method="POST">
      <div class="builder-grid">
        
        <!-- COMPONENT SELECTION -->
        <div class="board-card">
          <span class="section-label">SYSTEM HARDWARE SPECS</span>

          <div class="component-list">
            
            <!-- PROCESSOR -->
            <div class="component-item">
              <div class="component-icon"><i class="bi bi-cpu"></i></div>
              <div class="component-meta">
                <div class="component-name">PROCESSOR (CPU)</div>
                <select name="cpuId" class="form-select bg-dark text-white border-secondary mt-1 p-2 w-100 component-select" onchange="calculateTotal()">
                  <option value="" data-price="0">-- Select CPU --</option>
                  <% cpus.forEach(cpu => { %>
                    <option value="<%= cpu.id %>" data-price="<%= cpu.price %>">
                      <%= cpu.name %> - ₱<%= Number(cpu.price).toLocaleString() %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <!-- GRAPHICS CARD -->
            <div class="component-item">
              <div class="component-icon"><i class="bi bi-gpu-card"></i></div>
              <div class="component-meta">
                <div class="component-name">GRAPHICS CARD (GPU)</div>
                <select name="gpuId" class="form-select bg-dark text-white border-secondary mt-1 p-2 w-100 component-select" onchange="calculateTotal()">
                  <option value="" data-price="0">-- Select GPU --</option>
                  <% gpus.forEach(gpu => { %>
                    <option value="<%= gpu.id %>" data-price="<%= gpu.price %>">
                      <%= gpu.name %> - ₱<%= Number(gpu.price).toLocaleString() %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <!-- MOTHERBOARD -->
            <div class="component-item">
              <div class="component-icon"><i class="bi bi-motherboard"></i></div>
              <div class="component-meta">
                <div class="component-name">MOTHERBOARD</div>
                <select name="moboId" class="form-select bg-dark text-white border-secondary mt-1 p-2 w-100 component-select" onchange="calculateTotal()">
                  <option value="" data-price="0">-- Select Motherboard --</option>
                  <% motherboards.forEach(mobo => { %>
                    <option value="<%= mobo.id %>" data-price="<%= mobo.price %>">
                      <%= mobo.name %> - ₱<%= Number(mobo.price).toLocaleString() %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <!-- RAM -->
            <div class="component-item">
              <div class="component-icon"><i class="bi bi-memory"></i></div>
              <div class="component-meta">
                <div class="component-name">SYSTEM MEMORY (RAM)</div>
                <select name="ramId" class="form-select bg-dark text-white border-secondary mt-1 p-2 w-100 component-select" onchange="calculateTotal()">
                  <option value="" data-price="0">-- Select RAM --</option>
                  <% rams.forEach(ram => { %>
                    <option value="<%= ram.id %>" data-price="<%= ram.price %>">
                      <%= ram.name %> - ₱<%= Number(ram.price).toLocaleString() %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

          </div>
        </div>

        <!-- SUMMARY SIDEBAR -->
        <div class="summary-card">
          <div class="summary-header">
            <h2 class="summary-title">BUILD ESTIMATE</h2>
            <span class="budget-pill">COMPATIBLE</span>
          </div>

          <div class="total-box">
            <span class="total-label">ESTIMATED TOTAL:</span>
            <span class="total-value" id="buildTotal">₱0.00</span>
          </div>

          <button type="submit" class="btn-cyber w-100 py-3 text-center justify-content-center">
            ADD RIG TO CART <i class="bi bi-cart-plus ms-2"></i>
          </button>
        </div>

      </div>
    </form>
  </div>

  <script>
    function calculateTotal() {
      let total = 0;
      const selects = document.querySelectorAll('.component-select');
      
      selects.forEach(select => {
        const selectedOption = select.options[select.selectedIndex];
        const price = parseFloat(selectedOption.getAttribute('data-price')) || 0;
        total += price;
      });

      document.getElementById('buildTotal').innerText = '₱' + total.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }
  </script>

</body>
</html>