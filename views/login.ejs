<!DOCTYPE html>
<html lang="en">
<head>

    <link rel="stylesheet" href="/login.css">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | PHeripheral INC</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-utilities.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

</head>
<body>
  <nav class="itech-navbar py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="/" class="brand-logo">PHeripheral <span>INC</span></a>
      <a href="/" class="nav-link-custom">
        <i class="bi bi-arrow-left me-1"></i> BACK TO STORE
      </a>
    </div>
  </nav>

  <main class="login-shell">
    <section class="login-card" aria-labelledby="login-title">
      <div class="text-center">
        <div class="login-mark" aria-hidden="true">
          <i class="bi bi-person-lock"></i>
        </div>
        <h1 id="login-title" class="login-title">Welcome back</h1>
        <p class="login-subtitle">Sign in to manage your gear and orders.</p>
      </div>

      <form action="/login" method="post">
        <div class="mb-3">
          <label class="form-label" for="email">EMAIL ADDRESS</label>
          <input class="form-control" id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        </div>

        <div class="mb-3">
          <label class="form-label" for="password">PASSWORD</label>
          <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <label class="d-flex align-items-center gap-2 text-secondary small">
            <input type="checkbox" name="remember" value="true">
            Remember me
          </label>
          <a href="#" class="nav-link-custom small">Forgot password?</a>
        </div>

        <button type="submit" class="btn-cyber">Sign in <i class="bi bi-arrow-right ms-1"></i></button>
      </form>

      <p class="login-footer">New to PHeripheral? <a href="/register">Create an account</a></p>
    </section>
  </main>
</body>
</html>
